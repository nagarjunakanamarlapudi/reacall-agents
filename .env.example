# The credential-free deterministic mode is the default.
RECALLOPS_MODEL_MODE=deterministic
# Set these only when RECALLOPS_MODEL_MODE=openai. Keep the key in an ignored local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=0
# Allowed: none, low, medium, high, xhigh; the selected model must support the effort.
OPENAI_REASONING_EFFORT=medium
# OPENAI_API_KEY alone does not enable live planning; the explicit mode controls it.
# make eval-model uses the shared OpenAI service with the configuration above.
# Optional override: set LIVE_MODEL_ADAPTER=module:attribute for a reviewed custom factory.
LIVE_MODEL_ADAPTER=
RECALLOPS_SOURCE_MODE=snapshot
RECALLOPS_DATA_DIR=data
