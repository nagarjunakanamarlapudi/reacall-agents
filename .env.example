# The credential-free deterministic mode is the default.
RECALLOPS_MODEL_MODE=deterministic
# Set these only when RECALLOPS_MODEL_MODE=openai. Keep the key in an ignored local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY alone does not enable live planning; the explicit mode controls it.
# Live evaluation additionally requires an explicit trusted local adapter.
# Set LIVE_MODEL_ADAPTER=module:attribute only after implementing that adapter.
LIVE_MODEL_ADAPTER=
RECALLOPS_SOURCE_MODE=snapshot
RECALLOPS_DATA_DIR=data
