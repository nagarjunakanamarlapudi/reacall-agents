      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic"},
      "input": {"case_id": "CASE-R07", "thread_id": "thread-r07"},
      "faults": [{"scenario": "remove_trace_event", "target": "EV-003", "times": 1}],
