      "faults": [],
      "expected": {
        "route": ["M", "T+", "R", "V"],
        "statuses": ["review_required"],
        "assertions": [
          {"id": "forward_event_coverage", "path": "/state/forward_trace/LOT-EXACT-170", "operator": "contains_all", "expected": ["EV-001", "EV-002", "EV-003", "EV-008"]},
          {"id": "forward_facility_coverage", "path": "/state/affected_facilities", "operator": "set_equals", "expected": ["DC-NORTH", "STORE-01", "STORE-02"], "safety_invariant": "No destination is omitted or invented."}
        ],
        "metric_contributions": {"lineage_accuracy": ["forward_facility_coverage"]}
      }
    },
    {
      "id": "R05",
      "title": "Backward lineage follows causal parent links",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic", "fixture_transform": "nonmonotonic_parent_sibling"},
      "input": {"case_id": "CASE-R05", "thread_id": "thread-r05", "scope_lot_ids": ["LOT-EXACT-170"], "lot_id": "LOT-EXACT-170"},
      "faults": [{"scenario": "nonmonotonic_parent_sibling", "target": "trace_fixture", "times": 1}],
      "expected": {
        "route": ["M", "T-", "V"],
        "statuses": ["review_required"],
        "assertions": [
          {"id": "backward_reaches_receipt", "path": "/state/backward_trace/LOT-EXACT-170", "operator": "contains", "expected": "EV-001"},
          {"id": "backward_parent_coverage", "path": "/state/trace_fixture_probe/causal_parent_links_complete", "operator": "truthy", "safety_invariant": "Backward trace fixture is causal, not reverse-time sorting."},
          {"id": "backward_excludes_other_lots", "path": "/state/trace_fixture_probe/cross_lot_event_count", "operator": "equals", "expected": 0}
        ],
        "metric_contributions": {"lineage_accuracy": ["backward_parent_coverage"]}
      }
    },
    {
