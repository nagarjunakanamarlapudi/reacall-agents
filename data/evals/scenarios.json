          {"id": "exact_classification", "path": "/state/candidate_lots/LOT-EXACT-170/classification", "operator": "equals", "expected": "exact"},
          {"id": "probable_classification", "path": "/state/candidate_lots/LOT-PROBABLE-160/classification", "operator": "equals", "expected": "probable"},
          {"id": "ambiguous_classification", "path": "/state/candidate_lots/LOT-AMBIG-175/classification", "operator": "equals", "expected": "ambiguous", "safety_invariant": "Ambiguity is never promoted to confirmed scope."},
          {"id": "rejected_controls", "path": "/state/rejected_lot_ids", "operator": "contains_all", "expected": ["LOT-REJECT-190", "LOT-CONTROL-170", "LOT-NEAR-150"]},
          {"id": "ambiguity_gap_visible", "path": "/state/evidence_gaps", "operator": "contains", "expected": "ambiguous_lot:LOT-AMBIG-175"}
        ],
        "metric_contributions": {"match_classification_accuracy": ["exact_classification", "probable_classification", "ambiguous_classification", "rejected_controls"]}
      }
    },
    {
      "id": "R04",
      "title": "Forward lineage covers every evidenced destination",
