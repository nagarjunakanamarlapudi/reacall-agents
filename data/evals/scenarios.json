    {
      "id": "R08",
      "title": "Retry middleware boundary retries once without duplicating attempts",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic", "probe_boundary": "middleware.with_retry", "max_attempts": 2, "fake_delays": [0]},
      "input": {"case_id": "CASE-R08", "thread_id": "thread-r08"},
      "faults": [{"scenario": "transient_timeout", "target": "middleware.with_retry:match_lots", "times": 1}],
      "expected": {
        "route": ["I", "P", "M", "T+", "T-", "R", "V", "H"],
        "statuses": ["review_required"],
        "assertions": [
          {"id": "transient_retry_recovers", "path": "/state/middleware_probe/status", "operator": "equals", "expected": "recovered"},
          {"id": "transient_retry_bounded", "path": "/state/middleware_probe/retry_count", "operator": "equals", "expected": 1, "safety_invariant": "The isolated middleware retry probe is bounded and occurs once."},
          {"id": "match_called_twice", "path": "/counters/match_lots_calls", "operator": "equals", "expected": 2}
        ],
        "metric_contributions": {"recovery_correctness": ["transient_retry_recovers"], "bounded_execution_rate": ["transient_retry_bounded"]}
      }
    },
    {
      "id": "R09",
      "title": "Circuit-breaker middleware opens after repeated trace failures",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic", "probe_boundary": "middleware.CircuitBreaker", "circuit_threshold": 2, "max_attempts": 2},
      "input": {"case_id": "CASE-R09", "thread_id": "thread-r09"},
      "faults": [{"scenario": "rate_limited", "target": "middleware.CircuitBreaker:trace_forward", "times": 2, "parameters": {"status_code": 429}}],
      "expected": {
        "route": ["I", "P", "M", "T+", "T-", "R", "V", "H"],
