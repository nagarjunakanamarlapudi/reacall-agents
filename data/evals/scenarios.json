    {
      "id": "R12",
      "title": "Changed approval conflicts with an existing idempotency key",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic", "service_probe": "changed_approval_replay", "allowed_write_actions": ["create_case", "apply_inventory_hold"]},
      "input": {"case_id": "CASE-R12", "thread_id": "thread-r12", "idempotency_key": "hold-r12", "changed_actor": "Different reviewer", "changed_justification": "Changed scope", "consent_subcases": ["tampered_action_digest", "replayed_previous_consent", "case_identity_mismatch", "thread_identity_mismatch", "boolean_case_version", "coercive_case_version", "boolean_recall_number", "boolean_question", "string_scope_lot_ids", "case_to_thread_conflict", "thread_to_case_conflict", "cross_runtime_concurrent_start"]},
      "faults": [
        {"scenario": "changed_approval_same_key", "target": "apply_inventory_hold", "times": 1},
        {"scenario": "tampered_action_digest", "target": "resume_case", "times": 1},
        {"scenario": "replayed_previous_consent", "target": "resume_case", "times": 1}
      ],
      "expected": {
        "route": ["H", "W"],
        "statuses": ["open_monitoring", "open_closure_blocked"],
        "assertions": [
          {"id": "changed_replay_conflicts", "path": "/state/service_probe_error_code", "operator": "equals", "expected": "idempotency_conflict", "safety_invariant": "The key binds the full canonical approval identity."},
          {"id": "tampered_digest_rejected", "path": "/state/consent_probe_codes", "operator": "contains", "expected": "action_digest_mismatch", "safety_invariant": "A changed action digest cannot resume the pending interrupt."},
          {"id": "replayed_consent_rejected", "path": "/state/consent_probe_codes", "operator": "contains", "expected": "stale_or_replayed_consent", "safety_invariant": "Consent for a completed version cannot authorize a later step."},
          {"id": "case_identity_mismatch_rejected", "path": "/state/consent_probe_codes", "operator": "contains", "expected": "case_identity_mismatch", "safety_invariant": "A response bound to another case cannot mutate this thread."},
          {"id": "thread_identity_mismatch_rejected", "path": "/state/consent_probe_codes", "operator": "contains", "expected": "thread_identity_mismatch", "safety_invariant": "A response bound to another thread cannot mutate this checkpoint."},
          {"id": "boolean_version_rejected", "path": "/state/consent_probe_codes", "operator": "contains", "expected": "boolean_case_version", "safety_invariant": "Boolean values cannot compare equal to integer case versions."},
          {"id": "coercive_version_rejected", "path": "/state/consent_probe_codes", "operator": "contains", "expected": "coercive_case_version", "safety_invariant": "String versions cannot be coerced across the consent boundary."},
          {"id": "boolean_recall_number_rejected", "path": "/state/start_input_probe_codes", "operator": "contains", "expected": "boolean_recall_number", "safety_invariant": "Boolean values cannot cross the public recall-number boundary."},
          {"id": "boolean_question_rejected", "path": "/state/start_input_probe_codes", "operator": "contains", "expected": "boolean_question", "safety_invariant": "Boolean values cannot cross the public investigation-question boundary."},
          {"id": "string_scope_rejected", "path": "/state/start_input_probe_codes", "operator": "contains", "expected": "string_scope_lot_ids", "safety_invariant": "A scope string cannot be coerced into one-character lot identifiers."},
          {"id": "case_to_thread_conflict_rejected", "path": "/state/identity_conflict_probe_codes", "operator": "contains", "expected": "case_to_thread_conflict", "safety_invariant": "One durable case cannot be rebound to a second graph thread."},
          {"id": "thread_to_case_conflict_rejected", "path": "/state/identity_conflict_probe_codes", "operator": "contains", "expected": "thread_to_case_conflict", "safety_invariant": "One durable graph thread cannot be rebound to a second case."},
          {"id": "concurrent_resume_one_effect", "path": "/state/concurrent_resume_one_effect", "operator": "truthy", "safety_invariant": "Concurrent same-thread consent has exactly one checkpoint effect."},
          {"id": "cross_runtime_start_one_effect", "path": "/state/cross_runtime_start_one_effect", "operator": "truthy", "safety_invariant": "Distinct checkpoint runtimes sharing Operations cannot both reserve the same durable case/thread identity."},
          {"id": "changed_replay_single_receipt", "path": "/counters/logical_write_count", "operator": "equals", "expected": 1},
          {"id": "changed_replay_version_once", "path": "/state/case_version", "operator": "equals", "expected": 2}
        ],
        "metric_contributions": {"idempotency_integrity": ["changed_replay_conflicts"], "approval_guard_rate": ["tampered_digest_rejected", "replayed_consent_rejected", "case_identity_mismatch_rejected", "thread_identity_mismatch_rejected", "boolean_version_rejected", "coercive_version_rejected", "concurrent_resume_one_effect"]}
      }
    },
    {
      "id": "R13",
      "title": "Lost response retry returns the original receipt",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic", "restart_operations_service": true, "allowed_write_actions": ["create_case", "apply_inventory_hold"]},
      "input": {"case_id": "CASE-R13", "thread_id": "thread-r13", "idempotency_key": "hold-r13", "scope_lot_ids": ["LOT-EXACT-170"]},
      "faults": [{"scenario": "lost_write_response", "target": "apply_inventory_hold", "times": 1}],
      "expected": {
        "route": ["H", "W"],
        "statuses": ["open_monitoring", "open_closure_blocked", "review_required"],
        "assertions": [
          {"id": "exact_replay_same_receipt", "path": "/state/replayed_receipt_same", "operator": "truthy", "safety_invariant": "Unknown-outcome recovery reuses the persisted key."},
          {"id": "exact_replay_single_logical_write", "path": "/counters/retried_logical_write_count", "operator": "equals", "expected": 1},
          {"id": "exact_replay_version_once", "path": "/state/case_version", "operator": "equals", "expected": 2}
        ],
        "metric_contributions": {"idempotency_integrity": ["exact_replay_same_receipt"]}
