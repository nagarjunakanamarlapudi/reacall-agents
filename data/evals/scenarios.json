          {"id": "on_hand_evidence", "path": "/state/reconciliation/LOT-EXACT-170/component_evidence/on_hand", "operator": "nonempty"},
          {"id": "quarantined_evidence", "path": "/state/reconciliation/LOT-EXACT-170/component_evidence/quarantined", "operator": "nonempty"},
          {"id": "sold_evidence", "path": "/state/reconciliation/LOT-EXACT-170/component_evidence/sold", "operator": "nonempty"},
          {"id": "returned_evidence", "path": "/state/reconciliation/LOT-EXACT-170/component_evidence/returned", "operator": "nonempty"},
          {"id": "disposed_evidence", "path": "/state/reconciliation/LOT-EXACT-170/component_evidence/disposed", "operator": "nonempty"},
          {"id": "unaccounted_evidence", "path": "/state/reconciliation/LOT-EXACT-170/component_evidence/unaccounted", "operator": "nonempty"},
          {"id": "received_quantity_exact", "path": "/state/reconciliation/LOT-EXACT-170/received", "operator": "equals", "expected": 1200},
          {"id": "on_hand_quantity_exact", "path": "/state/reconciliation/LOT-EXACT-170/on_hand", "operator": "equals", "expected": 300},
          {"id": "quarantined_quantity_exact", "path": "/state/reconciliation/LOT-EXACT-170/quarantined", "operator": "equals", "expected": 200},
          {"id": "sold_quantity_exact", "path": "/state/reconciliation/LOT-EXACT-170/sold", "operator": "equals", "expected": 550},
          {"id": "returned_quantity_exact", "path": "/state/reconciliation/LOT-EXACT-170/returned", "operator": "equals", "expected": 20},
