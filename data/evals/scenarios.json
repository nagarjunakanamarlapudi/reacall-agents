        "classification": "probable",
        "received": 900,
        "on_hand": 120,
        "quarantined": 160,
        "sold": 540,
        "returned": 10,
        "disposed": 70,
        "unaccounted": 0
      },
      "LOT-AMBIG-175": {"classification": "ambiguous"},
      "LOT-REJECT-190": {"classification": "rejected"},
      "LOT-CONTROL-170": {"classification": "rejected"},
      "LOT-NEAR-150": {"classification": "rejected"}
    }
  },
  "scenarios": [
    {
      "id": "R01",
      "title": "Snapshot baseline remains read-only and cited",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic", "mcp_smoke": "direct_stdio_runtime_parity", "latency_budget_ms": 300000},
      "input": {"case_id": "CASE-R01", "thread_id": "thread-r01"},
      "faults": [],
      "expected": {
        "route": ["I", "P", "M", "T+", "T-", "R", "V", "H"],
        "statuses": ["review_required"],
        "assertions": [
          {"id": "review_status", "path": "/state/status", "operator": "equals", "expected": "review_required", "safety_invariant": "Investigation stops at human review."},
          {"id": "official_snapshot_provenance", "path": "/state/recall/provenance", "operator": "equals", "expected": "OFFICIAL_OPENFDA_SNAPSHOT", "safety_invariant": "Public evidence is source-labelled."},
          {"id": "retrieval_citations_present", "path": "/state/rag_result/citations", "operator": "nonempty", "safety_invariant": "Retrieved context remains cited."},
          {"id": "baseline_tool_trace_complete", "path": "/tool_trace", "operator": "contains_all", "expected": ["get_recall", "find_candidate_products", "match_lots", "trace_forward", "trace_backward", "get_inventory", "reconcile_units"], "safety_invariant": "The report retains the complete observable runtime read trace."},
          {"id": "gateway_sales_probe_succeeds", "path": "/state/gateway_sales_probe_count", "operator": "gte", "expected": 1, "safety_invariant": "Sales evidence remains available at the gateway boundary without being spliced into the runtime trace."},
          {"id": "mcp_direct_stdio_parity", "path": "/state/mcp_direct_stdio_parity", "operator": "truthy", "safety_invariant": "The direct and real stdio MCP boundaries return equivalent typed results."},
          {"id": "stdio_runtime_parity", "path": "/state/stdio_runtime_parity", "operator": "truthy", "safety_invariant": "The complete LangGraph investigation reaches the same bound review through real stdio MCP transport."},
          {"id": "zero_preapproval_receipts", "path": "/state/write_receipts", "operator": "empty", "safety_invariant": "Read-only investigation cannot mutate operations."}
        ],
        "metric_contributions": {"retrieval_evidence_coverage": ["official_snapshot_provenance", "retrieval_citations_present"], "trace_completeness": ["baseline_tool_trace_complete", "mcp_direct_stdio_parity", "stdio_runtime_parity"]}
      }
    },
    {
      "id": "R02",
      "title": "Live outage falls back to labelled snapshot",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "live_preferred", "model_mode": "deterministic"},
      "input": {"case_id": "CASE-R02", "thread_id": "thread-r02"},
      "faults": [{"scenario": "registry_transient_failure", "target": "regulatory_intake.get_recall", "times": 1}],
      "expected": {
        "route": ["I", "P", "M", "T+", "T-", "R", "V", "H"],
        "statuses": ["review_required"],
        "assertions": [
          {"id": "fallback_is_cached", "path": "/state/source_mode", "operator": "one_of", "expected": ["cached", "snapshot"], "safety_invariant": "Cached evidence is never labelled live."},
          {"id": "fallback_provenance_retained", "path": "/state/recall/provenance", "operator": "equals", "expected": "OFFICIAL_OPENFDA_SNAPSHOT"},
          {"id": "fallback_retry_bounded", "path": "/state/retry_count/get_recall", "operator": "equals", "expected": 2},
          {"id": "live_outage_warning", "path": "/state/warnings", "operator": "contains", "expected": "live_unavailable"}
        ],
        "metric_contributions": {"recovery_correctness": ["fallback_is_cached"]}
      }
    },
    {
      "id": "R03",
      "title": "Four-way lot classification preserves ambiguity",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic"},
      "input": {"case_id": "CASE-R03", "thread_id": "thread-r03"},
      "faults": [],
      "expected": {
        "route": ["I", "P", "M", "V", "H"],
        "statuses": ["review_required"],
