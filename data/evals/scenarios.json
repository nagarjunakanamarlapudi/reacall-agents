    "actor": "Food-safety manager",
    "approval": {
      "decision": "approve",
      "actor": "Food-safety manager",
      "justification": "Authorize simulated containment for confirmed scope; retain ambiguous lot for review."
    },
    "predicate": {
      "product_terms": ["eggs"],
      "upcs": ["011110609038"],
      "plant_codes": ["P-1950", "0840962"],
      "julian_start": 157,
      "julian_end": 184,
      "geography": ["Texas"],
      "hazard": "Possible Salmonella Enteritidis"
    }
  },
  "common_fixture": {
    "provenance": "OFFICIAL_OPENFDA_SNAPSHOT",
    "lots": {
      "LOT-EXACT-170": {
        "classification": "exact",
        "received": 1200,
