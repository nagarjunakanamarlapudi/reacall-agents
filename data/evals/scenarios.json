          {"id": "circuit_calls_bounded", "path": "/counters/trace_forward_transport_calls", "operator": "lte", "expected": 2, "safety_invariant": "Open circuit prevents later transport calls."},
          {"id": "circuit_no_write", "path": "/state/write_receipts", "operator": "empty"}
        ],
        "metric_contributions": {"recovery_correctness": ["circuit_failure_safe"], "bounded_execution_rate": ["circuit_calls_bounded"]}
      }
    },
    {
      "id": "R10",
      "title": "Runtime model fallback and isolated call budget both fail safe",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "live", "model_call_budget": 2, "subcases": ["runtime_provider_error", "middleware_budget_exhaustion"]},
      "input": {"case_id": "CASE-R10", "thread_id": "thread-r10"},
      "faults": [{"scenario": "model_failure", "target": "runtime.plan", "times": 1}, {"scenario": "model_budget_exceeded", "target": "middleware.CallBudget", "times": 1}],
