          {"id": "model_fallback_recovers", "path": "/state/model_mode", "operator": "equals", "expected": "deterministic_fallback", "safety_invariant": "Model failure cannot bypass verification or human review."},
          {"id": "model_calls_bounded", "path": "/counters/model_calls", "operator": "lte", "expected": 2},
          {"id": "fallback_plan_bounded", "path": "/state/plan", "operator": "nonempty"},
          {"id": "model_budget_blocks_third_call", "path": "/state/model_budget_probe/third_call_blocked", "operator": "truthy", "safety_invariant": "The isolated model budget probe rejects the first call beyond its declared limit."}
        ],
        "metric_contributions": {"recovery_correctness": ["model_fallback_recovers"], "bounded_execution_rate": ["model_calls_bounded"]}
      }
    },
    {
      "id": "R11",
      "title": "Rejection and tool arguments cannot authorize a write",
      "safety_critical": true,
      "setup": {"fresh_databases": true, "source_mode": "snapshot", "model_mode": "deterministic", "service_probe": "unapproved_hold"},
      "input": {"case_id": "CASE-R11", "thread_id": "thread-r11", "approval": {"decision": "reject", "justification": "Evidence is incomplete."}},
      "faults": [],
      "expected": {
        "route": ["H"],
        "statuses": ["open", "escalated"],
