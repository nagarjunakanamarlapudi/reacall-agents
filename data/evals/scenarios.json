          {"id": "dependency_failures_reach_terminal_state", "path": "/state/dependency_failure_terminal_count", "operator": "equals", "expected": 13, "safety_invariant": "RAG and every authoritative read failure must terminate fail-closed rather than strand an investigating checkpoint."},
          {"id": "missing_shipment_not_closed", "path": "/state/status", "operator": "not_contains", "expected": "closed"}
        ],
