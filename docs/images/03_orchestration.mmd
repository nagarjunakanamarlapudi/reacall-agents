flowchart TB
  classDef control fill:#dbeafe,stroke:#2563eb,color:#111827
  classDef llm fill:#ede9fe,stroke:#7c3aed,color:#111827
  classDef safe fill:#dcfce7,stroke:#15803d,color:#111827
  classDef human fill:#ffedd5,stroke:#c2410c,color:#111827
  RAG["Durable Agentic RAG<br/>bounded sparse+dense fusion / rerank<br/>policy-based critique / rewrite"]:::control
  P["OpenAI LLM planning<br/>observed write_todos"]:::llm
  DA["Deep Agent supervisor<br/>OpenAI • sequential task delegation"]:::llm
  RI["1 • LLM Regulatory Intake<br/>recall-intelligence • sealed Registry reads"]:::llm
  PM["2 • LLM Product / Lot Matching<br/>case / RAG / validated prior claims"]:::llm
  TR["3 • LLM Traceability / Reconciliation<br/>sealed Traceability reads + prior claims"]:::llm
  CO["4 • LLM Containment / Communications<br/>validated prior claims • no MCP tools"]:::llm
  CLAIMS["Structured synthesis → safe typed claims<br/>all four complete • unverified projection"]:::control
  VC["Independent Verification / Critic<br/>independent source verifier re-reads records<br/>accept exact evidence or stop before review"]:::safe
  AR["Action review interrupt<br/>StateGraph control • approve writes zero"]:::human
  EC["Execution confirmation interrupt<br/>exact action / version / digest"]:::human
  W["Approved graph node → Operations MCP<br/>one simulated write / version"]:::control
  RCPT["Receipt + version increment<br/>create_case v0→v1<br/>apply_inventory_hold v1→v2"]:::safe
  NEXT["Fresh action review or closure gate<br/>Open — closure blocked for flagship"]:::control
  RAG --> P --> DA --> RI --> PM --> TR --> CO --> CLAIMS --> VC --> AR --> EC --> W --> RCPT --> NEXT
  NEXT -->|next eligible action| AR
  VC -->|unsupported / incomplete| STOP["Semantic stop • zero writes"]:::human
  TC["Typed trajectory capture<br/>detached safe events • no raw prompts"]:::control
  OE["Orchestration comparison<br/>offline baseline + additional measured live lane"]:::control
  ER["Read-only evaluation report<br/>excluded from action authority"]:::safe
  TC --> OE --> ER
  VC -. read-only typed events .-> TC
