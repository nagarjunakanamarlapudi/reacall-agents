%%{init: {"flowchart": {"rankSpacing": 30, "nodeSpacing": 24, "subGraphTitleMargin": {"top": 0, "bottom": 20}}}}%%
flowchart TB
  classDef official fill:#dbeafe,stroke:#2563eb,color:#111827
  classDef synthetic fill:#ffedd5,stroke:#ea580c,color:#111827
  classDef review fill:#fef3c7,stroke:#ca8a04,color:#111827
  classDef approved fill:#dcfce7,stroke:#16a34a,color:#111827
  classDef blocked fill:#fee2e2,stroke:#dc2626,color:#111827

  NOTICE["FDA / regulator<br/>Official public notice / enforcement record<br/><br/>Consumers<br/>Official recall information may come from<br/>FDA or the recalling firm, when applicable"]:::official
  DEMO_NOTE["SYNTHETIC — ACADEMIC DEMO<br/>Boundary: fictional retailer evidence and simulated operations below<br/>RecallOps contacts neither regulators nor consumers"]:::synthetic

  subgraph STAGE1["STAGE 1 — CONTAINMENT ACTION"]
    direction TB
    TRACE["Recall coordinator<br/>Verify official scope; request evidence from<br/>Supplier + DC / store"]:::synthetic
    ACTION_REVIEW["Food-safety manager<br/>First human action review<br/>Exact proposed action + case version<br/>predicate • targets • evidence • one version truth"]:::review
    ACTION_GATE{"Authorize the exact simulated action<br/>at this case version?"}:::review
    RECORD["DC / store<br/>Record authorized simulated action"]:::synthetic
    EVIDENCE["Operation receipt • disposition evidence<br/>Unit reconciliation • Every facility acknowledgement"]:::synthetic
    ACTION_HOLD["Keep open / edit / reject / escalate<br/>No simulated write"]:::blocked

    TRACE --> ACTION_REVIEW --> ACTION_GATE
    ACTION_GATE -->|authorize exact action| RECORD
    ACTION_GATE -->|not authorized| ACTION_HOLD
    RECORD --> EVIDENCE
  end

  subgraph STAGE2["STAGE 2 — INTERNAL CLOSURE"]
    direction TB
    CLOSURE_REQUEST["Recall coordinator<br/>Explicit closure request<br/>recorded action + authoritative case version"]:::review
    GATE_EVAL{"Deterministic closure gate evaluation<br/>receipt present? • unaccounted = 0?<br/>every affected facility acknowledged?"}:::review
    CLOSURE_REVIEW["Food-safety manager<br/>Second human closure review"]:::review
    CLOSURE_GATE{"Authorize internal retailer closure?"}:::review
    CLOSED["Close fictional retailer case<br/>auditable closure evidence retained<br/>FDA termination is separate from retailer internal closure"]:::approved
    OPEN["Keep open / escalate<br/>Internal closure blocked<br/>resolve gap or revise request"]:::blocked

    CLOSURE_REQUEST --> GATE_EVAL
    GATE_EVAL -->|all deterministic gates pass| CLOSURE_REVIEW
    CLOSURE_REVIEW --> CLOSURE_GATE
    CLOSURE_GATE -->|close| CLOSED
    CLOSURE_GATE -->|keep open / escalate| OPEN
    GATE_EVAL -->|gap or missing acknowledgement| OPEN
  end

  NOTICE -->|official scope evidence enters here| DEMO_NOTE
  DEMO_NOTE --> TRACE
  EVIDENCE --> CLOSURE_REQUEST
